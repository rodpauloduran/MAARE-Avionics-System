# Normalise line endings in the repository; check out native on each platform.
* text=auto

# Source that should always be LF in the repo
*.md   text eol=lf
*.txt  text eol=lf
*.py   text eol=lf
*.ino  text eol=lf
*.html text eol=lf
*.jsx  text eol=lf

# Binary — never touch, never diff as text
# `* text=auto` above applies EOL heuristics to anything not listed here, so
# every binary format the repo carries needs an entry or it can be corrupted
# on checkout.
*.xlsx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.svg  text eol=lf
*.pdf  binary
*.mp4  binary
